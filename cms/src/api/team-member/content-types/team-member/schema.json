{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Team Member",
    "description": "People shown on the About page team grid."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "note": {
      "type": "text",
      "description": "Short bio line shown on the team card"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "True once the profile/photo has been confirmed for publication"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
