# ============================================================
# AJIYA CMS (Strapi) — ENVIRONMENT
# ============================================================
# Generate real values for every secret below — never reuse these placeholders, and never
# commit real values. `openssl rand -base64 32` works for any of the secret/salt fields.

HOST=0.0.0.0
PORT=1337

# Comma-separated; Strapi rotates cookie/session signing across all of these.
APP_KEYS=replaceWithGeneratedKey1,replaceWithGeneratedKey2
API_TOKEN_SALT=replaceWithGeneratedSalt
ADMIN_JWT_SECRET=replaceWithGeneratedSecret
TRANSFER_TOKEN_SALT=replaceWithGeneratedSalt
JWT_SECRET=replaceWithGeneratedSecret
ENCRYPTION_KEY=replaceWithGeneratedKey

# Set once this sits behind a reverse proxy/CDN in staging/production.
CMS_PUBLIC_URL=
CMS_TRUST_PROXY=false

# ============================================================
# DATABASE
# ============================================================
# Local dev: leave as sqlite (the default). Staging/production: switch to postgres.
DATABASE_CLIENT=sqlite
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://username:password@host:5432/ajiya_cms
# DATABASE_SSL=true

# ============================================================
# CORS
# ============================================================
# Comma-separated exact browser origins allowed to call the Strapi API directly.
CMS_ALLOWED_ORIGINS=http://localhost:5173
