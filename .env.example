# ============================================================
# AJIYA URBAN RISE — ENVIRONMENT
# ============================================================
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
LOG_LEVEL=info

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://username:password@localhost:5432/ajiya
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# ============================================================
# CMS
# ============================================================
# Public Strapi API origin (see cms/SETUP.md). Also feeds the CSP img-src/connect-src.
VITE_CMS_URL=http://localhost:1337

# ============================================================
# CORS
# ============================================================
# Comma-separated exact browser origins.
# Example: ALLOWED_ORIGINS=https://ajiyaurbanrise.com,https://www.ajiyaurbanrise.com
ALLOWED_ORIGINS=http://localhost:5173

# ============================================================
# REVERSE PROXY
# ============================================================
# One trusted reverse proxy hop in production: TRUST_PROXY=1
# Do NOT use TRUST_PROXY=true.
TRUST_PROXY=1

# ============================================================
# LEAD NOTIFICATIONS
# ============================================================
# Optional but strongly recommended.
ENQUIRY_WEBHOOK_URL=

# ============================================================
# MONITORING
# ============================================================
# Optional if your hosting provider already provides external log/alert monitoring,
# but strongly recommended.
MONITORING_WEBHOOK_URL=

# ============================================================
# INTERNAL LEAD MANAGEMENT (/admin)
# ============================================================
# Both required to enable the page; if either is missing the admin API returns 404 (it never
# falls back to "open"). Password: 12+ characters, unique to this tool. Single shared
# credential — see server/adminAuth.ts for the limits of that.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ============================================================
# TRANSACTIONAL CONFIRMATION EMAIL (optional)
# ============================================================
# "We've received your enquiry" only — sent to the person who submitted the form. NOT the
# newsletter/marketing email provider, which is a separate, larger decision still on hold.
# Any real SMTP host works: Gmail (with an app password), Zoho, a business mailbox, or a
# transactional API that exposes SMTP (Resend, Postmark, etc.). Leave blank to disable —
# without SMTP_HOST + SMTP_FROM_EMAIL both set, no confirmation email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AJIYA Urban Rise
